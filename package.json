{
  "name": "mars2050-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:limits": "tsx scripts/check-limits.ts",
    "combat:snapshot": "tsx scripts/combat-snapshot.ts",
    "combat:ecs:golden": "tsx scripts/combat-ecs-golden.ts",
    "combat:metrics": "tsx scripts/combat-metrics-report.ts",
    "combat:ecs:benchmark": "tsx scripts/combat-ecs-benchmark.ts",
    "combat:qa:artifacts": "tsx scripts/combat-qa-artifacts.ts",
    "replay:visuals": "tsx scripts/check-replay-visual-assets.ts",
    "prebuild": "tsx scripts/check-limits.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "scaffold": "tsx scripts/scaffold.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:combat:scenarios": "vitest run src/__tests__/combat.qa-presets.test.ts",
    "test:combat:tier1": "vitest run src/__tests__/combat.tier1-role-scenarios.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:qa": "playwright test tests/e2e/simulator2-load.spec.ts tests/e2e/simulator2-replay.spec.ts --project=chromium",
    "test:e2e:replay": "playwright test tests/e2e/simulator2-replay.spec.ts --project=chromium",
    "test:e2e:replay-pixi": "playwright test tests/e2e/simulator2-replay-pixi.spec.ts --project=chromium",
    "test:e2e:replay-baseline": "playwright test tests/e2e/simulator2-replay-baseline.spec.ts --project=chromium",
    "test:e2e:replay-baseline:update": "playwright test tests/e2e/simulator2-replay-baseline.spec.ts --project=chromium --update-snapshots",
    "test:e2e:prod:simulator2": "playwright test tests/e2e/simulator2-production-smoke.spec.ts --config=playwright.production.config.ts --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "dependencies": {
    "@pixi/events": "^7.4.3",
    "@pixi/react": "^8.0.5",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@twa-dev/sdk": "^8.0.2",
    "next": "16.2.4",
    "pg": "^8.21.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "zod": "^4.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npx tsx scripts/check-limits.ts --diff HEAD --json"
    ],
    "*.test.ts": [
      "vitest run --reporter=verbose"
    ]
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
